students = [
    {"id": 1, "name": "rajesh"},
    {"id": 2, "name": "rahul"},
    {"id": 3, "name": "sruthi"}
]

num = int(input("Enter student ID: "))

found = False
for student in students:
    if student["id"] == num:
        print(f"Student name: {student['name']}")
        found = True
        break

if not found:
    print("Student not found!")
